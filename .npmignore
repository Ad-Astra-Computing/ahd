# package.json's "files" allow-list is authoritative for npm pack:
# nothing outside it ships regardless of what is listed here, and
# nothing listed here can add a file "files" excludes. This is a
# defence-in-depth layer for the day "files" regresses to something
# broader (e.g. the field is removed), not an active second filter
# today.

docs/critique-artifacts
docs/critique-artifacts/**
docs/evals
docs/evals/**
# Generated screenshot PNGs are ~2.4 MB and not needed by the
# published package; the SVG artwork in docs/artwork/ still ships.
docs/artwork/screenshots
docs/artwork/screenshots/**
evals
evals/**
critiques
critiques/**
out
out/**
coverage
coverage/**
result
tests
tests/**
.env
.env.*
*.log
.DS_Store

# Nix + dev tooling
flake.lock
flake.nix
.editorconfig
.nvmrc

# CI + repo meta — consumers don't need these
.github
.github/**
packages/**/node_modules

# TypeScript sources — dist/ carries the shipped artifacts
src
src/**
tsconfig.json
vitest.config.ts
